-- =====================
-- AUTO AIM LOOP (FIX)
-- =====================
game:GetService("RunService").RenderStepped:Connect(function()
    if settings.autohead then
        local char = player.Character
        if not char or not char:FindFirstChild("Head") then return end

        local closest = nil
        local dist = math.huge

        for _, v in pairs(game.Players:GetPlayers()) do
            if v ~= player and v.Character and v.Character:FindFirstChild(settings.aimPart) then
                local mag = (v.Character[settings.aimPart].Position - char.Head.Position).Magnitude
                if mag < dist and mag < settings.aimFov then
                    dist = mag
                    closest = v
                end
            end
        end

        if closest then
            workspace.CurrentCamera.CFrame = CFrame.new(
                workspace.CurrentCamera.CFrame.Position,
                closest.Character[settings.aimPart].Position
            )
        end
    end
end)

